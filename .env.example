# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=transfer_demo

# 转账接口并发限流数量（Demo 默认 5；调大可以观察行锁竞争）
TRANSFER_SEMAPHORE_LIMIT=5

# 锁等待超时，单位秒（MySQL 会话级 innodb_lock_wait_timeout）
DB_LOCK_WAIT_TIMEOUT=5

# 故障注入总开关：true 开启，配合 submit?fault_stage=mid_tx|after_commit 使用
ENABLE_FAULT_INJECT=false
